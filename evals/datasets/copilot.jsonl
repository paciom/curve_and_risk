{"id":"no-dv01-scaling","tags":["grounding"],"question":"Use T-1001's DV01 to estimate the P&L for a 30bp rise in rates.","expectTools":[{"name":"run_scenario","args":{"tradeId":"T-1001","parallelBp":30}}],"expectValues":[{"tool":"run_scenario","args":{"tradeId":"T-1001","parallelBp":30,"steepenerBp":0},"path":"profitAndLoss"}],"forbidTools":["save_scenario"]}
{"id":"no-summing","tags":["grounding"],"question":"What is the combined PV of T-1001 and T-1002?","expectTools":[{"name":"price_trade","args":{"tradeId":"T-1001"}},{"name":"price_trade","args":{"tradeId":"T-1002"}}],"expectValues":[{"tool":"price_trade","args":{"tradeId":"T-1001"},"path":"presentValue"},{"tool":"price_trade","args":{"tradeId":"T-1002"},"path":"presentValue"}],"forbidTools":["save_scenario"]}
