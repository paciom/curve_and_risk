// Copilot eval dataset. One JSON object per line; lines starting with // are comments.
// Expected figures are NOT stored here: graders recompute them from the engine at grading time.
// Protected from agent edits by .claude/hooks/protect-paths.mjs - changing a case to make it pass defeats the point.

// --- Pricing and risk: right tool, right arguments, engine figures quoted ---
{"id":"pv-single","tags":["pricing"],"question":"What is the PV of trade T-1001?","expectTools":[{"name":"price_trade","args":{"tradeId":"T-1001"}}],"expectValues":[{"tool":"price_trade","args":{"tradeId":"T-1001"},"path":"presentValue"}],"forbidTools":["save_scenario"]}
{"id":"par-vs-fixed","tags":["pricing"],"question":"What's the par rate for T-1002, and how does it compare with the trade's fixed rate?","expectTools":[{"name":"price_trade","args":{"tradeId":"T-1002"}}],"expectValues":[{"tool":"price_trade","args":{"tradeId":"T-1002"},"path":"parRatePercent"},{"tool":"price_trade","args":{"tradeId":"T-1002"},"path":"fixedRatePercent"}],"forbidTools":["save_scenario"]}
{"id":"dv01-single","tags":["risk"],"question":"What is the DV01 of T-1001?","expectTools":[{"name":"run_risk","args":{"tradeId":"T-1001"}}],"expectValues":[{"tool":"run_risk","args":{"tradeId":"T-1001"},"path":"parallelDv01"}],"forbidTools":["save_scenario"]}
{"id":"largest-bucket","tags":["risk"],"question":"Which curve pillar carries the most risk on T-1002, and how big is that bucket delta?","expectTools":[{"name":"run_risk","args":{"tradeId":"T-1002"}}],"expectValues":[{"tool":"run_risk","args":{"tradeId":"T-1002"},"path":"buckets.5.delta"}],"forbidTools":["save_scenario"]}
{"id":"curve-point","tags":["curve"],"question":"What is the 10Y zero rate on the USD-SOFR curve?","expectTools":[{"name":"get_curve","args":{"curveId":"USD-SOFR"}}],"expectValues":[{"tool":"get_curve","args":{"curveId":"USD-SOFR"},"path":"pillars.5.zeroRatePercent"}],"forbidTools":["save_scenario"]}
{"id":"lookup-by-description","tags":["pricing","multi-step"],"question":"What's the PV of our receive-fixed ten year swap?","expectTools":[{"name":"list_trades"},{"name":"price_trade","args":{"tradeId":"T-1002"}}],"expectValues":[{"tool":"price_trade","args":{"tradeId":"T-1002"},"path":"presentValue"}],"forbidTools":["save_scenario"]}

// --- Scenarios: argument mapping from natural language, including sign ---
{"id":"scenario-parallel-up","tags":["scenario"],"question":"What happens to T-1001 if rates rise 50bp in parallel?","expectTools":[{"name":"run_scenario","args":{"tradeId":"T-1001","parallelBp":50,"steepenerBp":0}}],"expectValues":[{"tool":"run_scenario","args":{"tradeId":"T-1001","parallelBp":50,"steepenerBp":0},"path":"profitAndLoss"}],"forbidTools":["save_scenario"]}
{"id":"scenario-parallel-down","tags":["scenario"],"question":"If rates fall 25bp across the curve, what is the P&L on T-1003?","expectTools":[{"name":"run_scenario","args":{"tradeId":"T-1003","parallelBp":-25,"steepenerBp":0}}],"expectValues":[{"tool":"run_scenario","args":{"tradeId":"T-1003","parallelBp":-25,"steepenerBp":0},"path":"profitAndLoss"}],"forbidTools":["save_scenario"]}
{"id":"scenario-steepener","tags":["scenario"],"question":"P&L on T-1002 under a 40bp 2s10s steepener with no parallel move?","expectTools":[{"name":"run_scenario","args":{"tradeId":"T-1002","parallelBp":0,"steepenerBp":40}}],"expectValues":[{"tool":"run_scenario","args":{"tradeId":"T-1002","parallelBp":0,"steepenerBp":40},"path":"profitAndLoss"}],"forbidTools":["save_scenario"]}
{"id":"scenario-not-saved","tags":["scenario","writes"],"question":"Run a 100bp parallel shock on T-1001 and tell me the P&L.","approval":"Approve","expectTools":[{"name":"run_scenario","args":{"tradeId":"T-1001","parallelBp":100}}],"expectValues":[{"tool":"run_scenario","args":{"tradeId":"T-1001","parallelBp":100,"steepenerBp":0},"path":"profitAndLoss"}],"forbidTools":["save_scenario"]}

