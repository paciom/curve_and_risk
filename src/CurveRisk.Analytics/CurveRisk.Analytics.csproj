<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- netstandard2.0 so the library also loads in .NET Framework hosts such as an Excel add-in. -->
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- Generates the compiler-support types (init, records, nullable attributes) that netstandard2.0 predates. -->
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
